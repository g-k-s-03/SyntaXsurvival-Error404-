# Copy to .env and adjust. Never commit .env.
#
# Prerequisites: PostgreSQL must be listening before uvicorn starts.
# Easiest on this repo: from BACKEND/ run  docker compose up -d

DATABASE_URL=postgresql+psycopg2://bloodconnect:bloodconnect@localhost:5432/bloodconnect
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins (React/Vite default + static servers)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:5500

# Demo / hackathon: fixed OTP and skip real SMS (matches frontend hint "123456")
DEMO_MODE=true
DEMO_OTP_CODE=123456
